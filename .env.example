# ================================================
# [로컬 Windows - RTX 4060 8GB] 기본 설정
# 실행: copy .env.example .env  → python run_watchdog.py
# ================================================

# --- 경로 (이 PC에 맞게 변경) ---
# PROJECT_DIR: 이 파일이 있는 폴더 경로
PROJECT_DIR=C:\path\to\my-digital-persona
RAW_DATA_DIR=G:\
QDRANT_PATH=C:\path\to\my-digital-persona\qdrant_db
STATE_DB_PATH=C:\path\to\my-digital-persona\processed_files.db
LOG_FILE=C:\path\to\my-digital-persona\ingestion_log.txt
BACKUP_ROOT=C:\path\to\my-digital-persona\backups

# --- Qdrant (로컬 파일 모드 vs 서버 모드) ---
# 로컬 파일 모드 (기본): QDRANT_PATH 사용, QDRANT_URL 주석 처리
# 서버 모드 (GCP VM 등 외부접근 시): QDRANT_URL 설정, QDRANT_PATH 주석 처리
# QDRANT_URL=http://localhost:6333
# QDRANT_URL=http://<gcp-vm-ip>:6333

# --- poppler (Windows 필수) ---
# https://github.com/oschwartz10612/poppler-windows/releases 에서 설치 후 bin 폴더 경로 입력
POPPLER_PATH=C:\Users\<your-username>\Downloads\poppler-25.x.x\Library\bin

# --- OCR / 모델 ---
DPI=150
VISION_MODEL=qwen3-vl:8b
WHISPER_MODEL=base
# RTX 4060 8GB: Ollama(~8GB) + Whisper 병행 → small로 VRAM 절약
EMBED_MODEL_NAME=intfloat/multilingual-e5-small
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- 병렬 처리 (RTX 4060 기준 최적값) ---
MAX_VISION_WORKERS=2
MAX_AUDIO_WORKERS=1
QUEUE_SIZE=100
AUTO_BACKUP_INTERVAL_SEC=900

# --- Ollama 엔드포인트 ---
# 로컬 실행 시 둘 다 localhost
CLOUD_OLLAMA_URL=http://localhost:11434
LOCAL_OLLAMA_URL=http://localhost:11434
